<style>
  .chip {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.5;
    width: 24;
    padding-top: 1.1;
    padding-bottom: 1.1;
    padding-left: 1.6;
    padding-right: 1.6;
    background-color: rgba(20, 17, 31, 0.82);
    border-radius: 2.2;
    border-width: 0.15;
    border-color: #f6bfd0;
  }
  .title {
    font-size: 1.9;
    font-weight: medium;
    color: #fff0f4;
    text-align: center;
  }
  .count {
    font-size: 1.6;
    color: #f9dbe4;
    text-align: center;
  }
  .note {
    font-size: 1.3;
    color: #d8c9d0;
    text-align: center;
  }
</style>
<div id="shared-chip" class="chip">
  <span id="shared-title" class="title">Shared tree</span>
  <span id="shared-count" class="count">Waiting for news...</span>
  <span id="shared-note" class="note">Everyone who visits can water it</span>
</div>
