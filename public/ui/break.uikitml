<style>
  .card {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 1.2;
    width: 44;
    padding-top: 2;
    padding-bottom: 2;
    padding-left: 2.4;
    padding-right: 2.4;
    background-color: rgba(20, 17, 31, 0.9);
    border-radius: 3;
    border-width: 0.2;
    border-color: #ffd76a;
  }
  .title {
    font-size: 2.6;
    font-weight: medium;
    color: #fff6dc;
    text-align: center;
  }
  .row {
    display: flex;
    flex-direction: row;
    gap: 1;
  }
  .btn {
    display: flex;
    flex-grow: 1;
    flex-basis: 0;
    align-items: center;
    justify-content: center;
    padding-top: 2;
    padding-bottom: 2;
    background-color: #3a3350;
    border-radius: 1.8;
    border-width: 0.2;
    border-color: #6d6390;
  }
  .btn-text {
    font-size: 2.6;
    font-weight: medium;
    color: #fff6dc;
  }
  .summary {
    display: none;
    flex-direction: column;
    gap: 0.8;
  }
  .stat {
    font-size: 2.4;
    color: #e8dcc0;
    text-align: center;
  }
</style>
<div id="break-card" class="card">
  <span id="break-title" class="title">How long is your break?</span>
  <div id="break-choices" class="row">
    <div id="break-3" class="btn"><span id="break-3-t" class="btn-text">3 min</span></div>
    <div id="break-5" class="btn"><span id="break-5-t" class="btn-text">5 min</span></div>
    <div id="break-10" class="btn"><span id="break-10-t" class="btn-text">10 min</span></div>
  </div>
  <div id="break-summary" class="summary">
    <span id="break-minutes" class="stat">5 minutes of break</span>
    <span id="break-breaths" class="stat">0 breaths</span>
    <span id="break-cares" class="stat">0 cares</span>
    <span id="break-level" class="stat">Level 1</span>
    <span id="break-streak" class="stat">1 day in a row</span>
  </div>
</div>
