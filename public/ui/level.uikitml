<style>
  .chip {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.7;
    width: 24;
    padding-top: 1.2;
    padding-bottom: 1.2;
    padding-left: 1.6;
    padding-right: 1.6;
    background-color: rgba(20, 17, 31, 0.82);
    border-radius: 2.2;
    border-width: 0.15;
    border-color: #9fd98a;
  }
  .title {
    font-size: 1.9;
    font-weight: medium;
    color: #f4ffe9;
    text-align: center;
  }
  .track {
    display: flex;
    flex-direction: row;
    height: 0.9;
    background-color: #3a3350;
    border-radius: 0.45;
  }
  .fill {
    width: 0;
    height: 0.9;
    background-color: #9fd98a;
    border-radius: 0.45;
  }
  .streak-row {
    display: none;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 0.8;
  }
  .streak {
    font-size: 1.5;
    color: #ffe9a8;
  }
  .dots {
    display: flex;
    flex-direction: row;
    gap: 0.5;
  }
  .dot {
    width: 1.1;
    height: 1.1;
    border-radius: 0.55;
    background-color: #3a3350;
  }
  .xp {
    font-size: 1.5;
    color: #cfe8c4;
    text-align: center;
  }
</style>
<div id="level-chip" class="chip">
  <span id="level-title" class="title">Level 1 - Seed</span>
  <div id="level-track" class="track">
    <div id="level-fill" class="fill"></div>
  </div>
  <span id="level-xp" class="xp">0 / 5 XP</span>
  <div id="streak-row" class="streak-row">
    <span id="streak-text" class="streak">1 day in a row</span>
    <div class="dots">
      <div id="streak-dot-0" class="dot"></div>
      <div id="streak-dot-1" class="dot"></div>
      <div id="streak-dot-2" class="dot"></div>
      <div id="streak-dot-3" class="dot"></div>
      <div id="streak-dot-4" class="dot"></div>
      <div id="streak-dot-5" class="dot"></div>
      <div id="streak-dot-6" class="dot"></div>
    </div>
  </div>
</div>
